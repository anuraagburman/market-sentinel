{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://market-sentinel.local/schemas/claim.schema.json",
  "title": "Claim",
  "description": "An extracted statement tied to evidence. Support and contradiction are explicit. Missing values are never filled from model memory.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "statement", "evidence_ids", "relation", "extraction_version"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "statement": {"type": "string", "minLength": 1},
    "evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "relation": {"enum": ["supports", "contradicts", "context"]},
    "source_span": {"type": "string"},
    "entity": {"type": "string"},
    "metric": {"type": "string"},
    "period": {"type": "string"},
    "value": {"$ref": "common.schema.json#/$defs/decimal_string"},
    "unit": {"type": "string"},
    "kind": {"enum": ["fact", "calculation", "interpretation"]},
    "extraction_version": {"$ref": "common.schema.json#/$defs/version"}
  },
  "dependentRequired": {"value": ["unit", "period"]}
}
