{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://market-sentinel.local/schemas/portfolio_version.schema.json",
  "title": "PortfolioVersion",
  "description": "A confirmed import. Immutable once status is confirmed; corrections create a new version.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "tenant_id", "base_currency", "imported_at", "source_hash", "status"],
  "properties": {
    "id": {"$ref": "common.schema.json#/$defs/uuid"},
    "tenant_id": {"$ref": "common.schema.json#/$defs/uuid"},
    "base_currency": {"$ref": "common.schema.json#/$defs/currency"},
    "imported_at": {"$ref": "common.schema.json#/$defs/utc_timestamp"},
    "source_hash": {"$ref": "common.schema.json#/$defs/sha256"},
    "status": {"enum": ["preview", "confirmed"]},
    "confirmed_at": {"$ref": "common.schema.json#/$defs/utc_timestamp"},
    "previous_version_id": {"oneOf": [{"$ref": "common.schema.json#/$defs/uuid"}, {"type": "null"}]},
    "cash": {
      "description": "Included in totals only when supplied. Absent means unknown, not zero.",
      "type": "object",
      "additionalProperties": false,
      "required": ["amount", "currency"],
      "properties": {
        "amount": {"$ref": "common.schema.json#/$defs/decimal_string"},
        "currency": {"$ref": "common.schema.json#/$defs/currency"}
      }
    }
  },
  "if": {"properties": {"status": {"const": "confirmed"}}},
  "then": {"required": ["confirmed_at"]}
}
